# ==============================================================================
# RIB HOUSE - SAFARICOM DARAJA 2.0 M-PESA CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# Environment Mode: 'sandbox' (testing) or 'production' (live transactions)
MPESA_ENVIRONMENT=sandbox

# Safaricom Daraja Developer Credentials
# Obtain these from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Daraja Lipa Na M-Pesa Online (STK Push) Passkey
# Sandbox default passkey: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Shortcode / Business Number
# For Sandbox: 174379 (Head Office / Test shortcode)
# For Live Buy Goods / Till: Store Number or Head Office Shortcode registered on Daraja
MPESA_SHORTCODE=174379

# Actual Customer-Facing Till Number
MPESA_TILL_NUMBER=4977556

# Public Callback URL (Webhook) for Safaricom Confirmation Notifications
# Example: https://ribhouse.ke/api/mpesa/callback OR your ngrok/render/cloud url
MPESA_CALLBACK_URL=https://mydomain.com/api/mpesa/callback

# Order Hotline
HOTLINE_NUMBER=0724594204

# ==============================================================================
# ADMIN AUTHENTICATION & SECURITY CONFIGURATION
# ==============================================================================
JWT_SECRET=ribhouse_secret_jwt_key_2026_super_secure_9921_woodfired
ADMIN_DEFAULT_EMAIL=admin@ribhouse.co.ke
ADMIN_DEFAULT_USERNAME=admin
SESSION_EXPIRY_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

